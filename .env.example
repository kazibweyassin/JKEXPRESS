# Copy this file to `.env` and replace the placeholders with your real values.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jkexpress?schema=public"

# Cloudflare R2 storage configuration.
# R2_PUBLIC_URL must point to the public bucket URL, not the S3 API endpoint.
# Correct examples:
#   https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
#   https://my-bucket.<ACCOUNT_ID>.r2.cloudflarestorage.com
#   https://cdn.example.com
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://your-bucket.your-account-id.r2.cloudflarestorage.com"

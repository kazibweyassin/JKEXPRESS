# Database — Prisma + PostgreSQL
# Local (docker compose):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jkexpress?schema=public"
# Render: add a Postgres instance and copy its Internal/External URL here.
# Render often needs SSL:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jkexpress?sslmode=require"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Optional: OAuth providers (leave empty to use credentials only)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Object storage (local mock by default — set USE_LOCAL_STORAGE=true)
USE_LOCAL_STORAGE="true"
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Cloudflare R2 property-image storage
# R2_PUBLIC_URL is your bucket's r2.dev URL or connected custom domain.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Email (Resend-compatible)
# RESEND_API_KEY=
EMAIL_FROM="noreply@jkexpress.local"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="JK Express"

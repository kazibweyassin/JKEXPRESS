# Database
# Local (SQLite):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — change prisma/schema.prisma provider to "postgresql":
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jkexpress?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Optional: OAuth providers (leave empty to use credentials only)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Object storage (local mock by default — set USE_LOCAL_STORAGE=true)
USE_LOCAL_STORAGE="true"
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Email (Resend-compatible)
# RESEND_API_KEY=
EMAIL_FROM="noreply@jkexpress.local"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="JK Express"
